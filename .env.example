# Copier ce fichier en .env.local et remplir avec les valeurs de
# Supabase > Project Settings > API.
# Seules ces deux clés peuvent être publiques : l'URL et la clé "anon"
# (ou "publishable"). Elles ne donnent accès qu'à ce que la RLS autorise.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NE JAMAIS mettre ici la clé service_role avec un préfixe NEXT_PUBLIC_
# (contrôles n°2 et n°3). On en aura besoin à l'étape 2, côté serveur seulement :
# SUPABASE_SERVICE_ROLE_KEY=
